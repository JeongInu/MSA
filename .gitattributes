################################################
# 기본 텍스트 처리 (핵심)
################################################
* text=auto

################################################
# 줄바꿈 통일 (중요)
# Windows / Mac / Linux 모두 LF로 통일
################################################
*.java text eol=lf
*.kt text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

################################################
# 바이너리 파일
################################################
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

################################################
# Spring / Config 안전 처리
################################################
application-*.yml text eol=lf
application-*.properties text eol=lf